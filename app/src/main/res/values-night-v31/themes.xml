<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Sama dengan varian v27, ditambah splash screen Android 12+: latar
        senada jendela aplikasi, lingkaran lembut, dan logo not monokrom yang
        muncul memantul, supaya pembukaan aplikasi langsung terasa satu gaya
        dengan tampilan di dalamnya.
    -->
    <style name="Theme.Jamalify" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@color/app_window</item>
        <item name="android:navigationBarColor">@color/app_window</item>
        <item name="android:windowBackground">@color/app_window</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:forceDarkAllowed">false</item>
        <item name="android:windowSplashScreenBackground">@color/app_window</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/splash_circle</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="android:windowSplashScreenAnimationDuration">700</item>
    </style>
</resources>
