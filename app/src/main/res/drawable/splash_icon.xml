<?xml version="1.0" encoding="utf-8"?>
<!--
    Ikon splash: logo not berpasangan dari ic_logo, monokrom mengikuti tema.
    Not muncul membesar dengan sedikit pantulan, lalu balok pengikatnya
    menyusul — seperti dua nada yang baru saja dipetik.
-->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">
    <aapt:attr name="android:drawable">
        <vector
            android:width="108dp" android:height="108dp"
            android:viewportWidth="108" android:viewportHeight="108">
            <group android:name="mark"
                android:pivotX="55" android:pivotY="55"
                android:scaleX="0.4" android:scaleY="0.4">
                <path android:fillColor="@color/splash_mark"
                    android:pathData="M30,72 a10,8 0 1,0 20,0 a10,8 0 1,0 -20,0 z" />
                <path android:fillColor="@color/splash_mark"
                    android:pathData="M45,36 h5 v36 h-5 z" />
                <path android:fillColor="@color/splash_mark" android:fillAlpha="0.7"
                    android:pathData="M60,67 a10,8 0 1,0 20,0 a10,8 0 1,0 -20,0 z" />
                <path android:fillColor="@color/splash_mark" android:fillAlpha="0.7"
                    android:pathData="M75,31 h5 v36 h-5 z" />
                <path android:name="beam" android:fillColor="@color/splash_mark"
                    android:fillAlpha="0"
                    android:pathData="M45,36 L80,31 L80,41 L45,46 Z" />
            </group>
        </vector>
    </aapt:attr>

    <target android:name="mark">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator android:propertyName="scaleX"
                    android:valueFrom="0.4" android:valueTo="0.78"
                    android:duration="450"
                    android:interpolator="@android:interpolator/overshoot" />
                <objectAnimator android:propertyName="scaleY"
                    android:valueFrom="0.4" android:valueTo="0.78"
                    android:duration="450"
                    android:interpolator="@android:interpolator/overshoot" />
            </set>
        </aapt:attr>
    </target>

    <target android:name="beam">
        <aapt:attr name="android:animation">
            <objectAnimator android:propertyName="fillAlpha"
                android:valueFrom="0" android:valueTo="1"
                android:startOffset="300" android:duration="300"
                android:interpolator="@android:interpolator/fast_out_slow_in" />
        </aapt:attr>
    </target>
</animated-vector>
